

Algoritmo ArreglosDimensiones
	Definir i, 
	
	Dimension notas [5]  // este es un arreglo de 10 notas
	notas[1] <- 90
	notas[2] <- 100
	notas[3] <- 85
	notas[4] <- 70
	notas[5] <- 100
	
	para i <- 1 Hasta 5 Con Paso 1 Hacer
		Escribir "La nota # " , i, "es igual a: " , notas [i]
	FinPara
	
FinAlgoritmo

// Escribir las notas desde la consola

Para i <- 1 Hasta 5 Con Paso 1 Hacer
